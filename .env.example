# ============================================
# LOCAL DEVELOPMENT (backend reads env from the shell; Vite reads .env for VITE_* only)
# The backend does NOT auto-load this file (no dotenv). Export these vars in your
# terminal, or create a .env if you add dotenv later. Without DATABASE_URL the server
# falls back to the DB_* values below and connects to your LOCAL PostgreSQL.
# ============================================

# Server
PORT=3001
JWT_SECRET=your-secret-key-here

# Local PostgreSQL
# Ensure a PostgreSQL instance runs on this host/port with this user and database.
DB_USER=todo_user
DB_HOST=localhost
DB_NAME=todo_app
DB_PASSWORD=
DB_PORT=5432

# ============================================
# PRODUCTION (Render)
# Do NOT set DATABASE_URL locally. It is injected on Render as an environment variable.
# Backend source of truth: server/index.js reads process.env.DATABASE_URL when set.
# On Render Dashboard use the EXTERNAL database URL
# (PostgreSQL -> Connect -> External Database URL).
# The external URL works even if the Web Service and the database are in different
# regions. The internal URL (host like dpg-...-a) only resolves inside Render's
# private network and only from a service in the SAME region and workspace.
# ============================================

# DATABASE_URL=postgresql://user:pass@host:5432/db